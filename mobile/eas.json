{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": { "EXPO_PUBLIC_ALLOW_SERVER_CHANGE": "1" }
    },
    "production": {
      "android": { "buildType": "app-bundle" },
      "env": { "EXPO_PUBLIC_ALLOW_SERVER_CHANGE": "0" }
    }
  },
  "submit": {
    "production": {}
  }
}
