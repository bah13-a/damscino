{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_ENV": "test",
        "EXPO_PUBLIC_APP_ENV": "test",
        "EXPO_PUBLIC_ALLOW_SERVER_CHANGE": "0"
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "APP_ENV": "prod",
        "EXPO_PUBLIC_APP_ENV": "prod",
        "EXPO_PUBLIC_ALLOW_SERVER_CHANGE": "0",
        "EXPO_PUBLIC_API_URL": "https://51-20-252-36.sslip.io"
      }
    },
    "apk": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_ENV": "prod",
        "EXPO_PUBLIC_APP_ENV": "prod",
        "EXPO_PUBLIC_ALLOW_SERVER_CHANGE": "0",
        "EXPO_PUBLIC_API_URL": "https://51-20-252-36.sslip.io"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
