# HTTPS in front of the PWA (the camera of the staff scanner requires HTTPS)
{$DOMAIN} {
	encode zstd gzip

	# Android app, downloaded by infra/download-apk.sh into app-downloads/ (mounted read-only here)
	handle_path /downloads/* {
		root * /app/downloads
		@apk file
		header @apk Content-Type application/vnd.android.package-archive
		header @apk Content-Disposition attachment
		header @apk Cache-Control no-cache
		file_server
	}

	handle {
		reverse_proxy frontend:3000
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
}
