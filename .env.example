# Copy to .env for docker compose, or set as environment variables on the hosting platform.
DB_PASSWORD=change-me
JWT_SECRET=change-me-with-at-least-32-random-characters
QR_SECRET=change-me-with-at-least-32-random-characters
CREDENTIALS_SECRET=change-me-with-at-least-32-random-characters
ADMIN_PASSWORD=change-me-first-login
# SMS (docs/SMS.md) — production: phone with "SMS Gateway for Android", cloud mode credentials
SMS_GATEWAY_USER=
SMS_GATEWAY_PASSWORD=
